<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Debug builds only: put a launcher intent-filter back on the activity itself.

      In the release manifest the LAUNCHER filter lives on two `activity-alias`
      entries and never on the activity, because that is the only way to switch
      the app's name and icon between "Cystera" and a discreet "Records" at
      runtime. That is correct for users and invisible to them — but Flutter's
      own tooling finds the launch activity by looking for a `<activity>` with
      MAIN/LAUNCHER, so with aliases alone `flutter run` and
      `flutter test integration_test/` both fail with "package identifier or
      launch activity not found", before anything is even built.

      So development builds get a plain launcher entry, which shows up as a
      second icon in the dev app drawer. That is the right side of the trade:
      the artifact users install is unchanged, and the alternative is a project
      that cannot be run or integration-tested without editing the manifest.

      This file is not merged into release builds. The release manifest is what
      `tool/no_internet_check.dart` inspects.
    -->
    <application tools:node="merge">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
