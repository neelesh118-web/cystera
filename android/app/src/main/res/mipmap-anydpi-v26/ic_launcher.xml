<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's icon, adaptive only — which is what the app's minSdk of 26 buys: every
  device it installs on can draw this, so there is no legacy path to keep in step.

  The three layers are the ramp, the mark, and the shape-only version the system
  recolours on Android 13+. The flat PNGs beside this file exist for launchers and
  store listings that read a bitmap, and are generated by `tool/make_icons.py` from
  the same geometry rather than exported from a design file.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
