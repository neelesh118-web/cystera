<?xml version="1.0" encoding="utf-8"?>
<!--
  The discreet launcher icon.

  Adaptive only (v26+), which is why the app's minSdk is 26: the alternative is
  shipping bitmap PNGs at five densities for an icon whose whole purpose is to be
  unremarkable. The background is a flat slate rather than the app's rose, because
  a pink icon labelled "Records" is worse than no disguise at all.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_discreet_background" />
    <foreground android:drawable="@drawable/ic_discreet_foreground" />
    <monochrome android:drawable="@drawable/ic_discreet_foreground" />
</adaptive-icon>
