<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Slate, not rose: the discreet icon must not read as a health app. -->
    <color name="ic_discreet_background">#2B3038</color>

    <!--
      The launch window, and the one colour Android 12+ lets a splash screen have
      (its `windowSplashScreenBackground` takes a colour, not a drawable — so the
      gradient above is what pre-12 devices get and this flat crimson is what 12+
      gets, which is why the two use the same first stop of the ramp).

      `splash_mark` is drawn white on top of either one.
    -->
    <color name="splash_background">#C81E48</color>

    <!--
      What is behind the app while Flutter is starting, after the launch window is
      gone. It is the app's own background token (`Rose.paper`) rather than the
      platform's, because `?android:colorBackground` is white in light mode and
      black in dark, and neither is this app's paper — a frame of the wrong colour
      between the splash and the first Flutter frame is the flash this exists to
      remove.
    -->
    <color name="app_background">#FFF8F9</color>
</resources>
