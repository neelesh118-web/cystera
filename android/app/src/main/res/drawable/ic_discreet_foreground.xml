<?xml version="1.0" encoding="utf-8"?>
<!--
  The discreet icon's foreground: a plain notebook outline, no drop, no heart, no
  rose. Adaptive-icon foregrounds are drawn on a 108x108 canvas with the visible
  area inside the middle 72x72, so this shape stays well inside that safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card body. -->
    <path
        android:fillColor="#F2F3F5"
        android:pathData="M38,30 h26 a6,6 0 0 1 6,6 v36 a6,6 0 0 1 -6,6 h-26 a6,6 0 0 1 -6,-6 v-36 a6,6 0 0 1 6,-6 z" />

    <!-- Spine. -->
    <path
        android:fillColor="#C3C7CE"
        android:pathData="M32,30 h6 v48 h-6 z" />

    <!-- Three ruled lines, the only thing that reads at launcher size. -->
    <path
        android:fillColor="#8A9099"
        android:pathData="M46,44 h18 v3.5 h-18 z M46,54 h18 v3.5 h-18 z M46,64 h11 v3.5 h-11 z" />
</vector>
