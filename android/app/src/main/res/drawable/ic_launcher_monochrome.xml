        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M75.67,57.82 A22,22 0 1 1 50.18,32.33" />

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M63.06,38.44 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 z" />
</vector>
