<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background: the app's own ramp, crimson to rose, on the
  diagonal the header wash uses.

  A gradient rather than a flat colour because the icon and the app should look
  like the same object, and a vector rather than a PNG because the launcher masks
  this layer to whatever shape the device uses — a bitmap would be cropped at one
  density and stretched at another.

  The geometry is duplicated in `tool/make_icons.py` on purpose: the script writes
  the flat bitmaps that a store listing or an old launcher reads, and this file is
  what every installed device actually draws. They are the same design in two
  forms, and the comment in each says so.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FFC81E48" />
                <item android:offset="1" android:color="#FFFF7A94" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
