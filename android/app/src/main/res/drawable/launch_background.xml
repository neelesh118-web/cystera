<?xml version="1.0" encoding="utf-8"?>
<!--
  The first frame of the app, on Android 11 and below: the brand ramp with the mark
  centred on it.

  The mark is a bitmap rather than a vector here on purpose. A `bitmap` item is the
  only way a layer-list can size an image to its own density, and the assets beside
  this file (`splash_mark.png`, generated at 96dp in five buckets) are what the
  platform picks from — so the mark is never rescaled by the launcher, which is the
  difference between a crisp ring and a soft one.

  Android 12 and above do not read this file for the splash: they draw their own
  from `values-v31/styles.xml`, with the same mark and the same colour.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
