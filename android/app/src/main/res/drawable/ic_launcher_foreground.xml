<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's mark: a cycle ring with a gap, and a dot standing in the gap where the
  next period is due.

  Geometry, in the 108-unit adaptive canvas that Android masks for us:

    centre (54,54), ring radius 22, stroke 11 with round caps, dot radius 6.5
    the gap is 110 degrees centred on -45 degrees — the top-right
    so the arc runs from 10 degrees to 260 degrees, and 22 units of ring are
    missing (about 76 degrees once the round caps reach into it) with a dot in the
    middle of the opening

  Those proportions are load-bearing rather than cosmetic. At a 70-degree gap with
  a wider dot — the first version — the caps and the dot together filled the
  opening and the mark read as a plain closed ring, which is the one thing this
  icon must not be: the whole idea is a period that comes round again with the next
  one still to come.

  Stays inside the middle 72 units, which is the safe area every launcher mask
  keeps, so nothing here is ever cropped — the ring's outer edge is at 27.5.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The ring, drawn as one open arc rather than a circle with a bite taken out. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M75.67,57.82 A22,22 0 1 1 50.18,32.33" />

    <!-- The dot in the gap: the next one, not yet arrived. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M63.06,38.44 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 z" />
</vector>
