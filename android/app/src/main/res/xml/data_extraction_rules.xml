<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules.

  `android:allowBackup="false"` already stops cloud backup, but this file is the
  belt to that braces: it also refuses device-to-device transfer, which is
  governed separately on Android 12+. The point is that no part of the record
  reaches Google Drive, a new phone's cloning tool, or an OEM migration app
  without the user making a backup file themselves.

  This is not paranoia about our own data: the database is encrypted and the key
  is keystore-bound, so a copied file would be unreadable anyway. It is about not
  leaving a broken half-restore behind on a new phone — a restored database whose
  key did not come with it is exactly the "this phone's record cannot be opened"
  screen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
