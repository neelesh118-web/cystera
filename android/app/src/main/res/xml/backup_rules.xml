<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below backup rules, kept for completeness.

  `allowBackup="false"` is what actually does the work on every version; this file
  exists so that a future change to `allowBackup` cannot quietly enable cloud
  backup by removing only one line. See `data_extraction_rules.xml` for the
  Android 12+ equivalent.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
